<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MiniMockito.Shims.Experimental</AssemblyName>
    <RootNamespace>MiniMockito.Shims.Experimental</RootNamespace>
    <PackageId>MiniMockito.Shims.Experimental</PackageId>
    <Title>MiniMockito.Shims.Experimental</Title>
    <Version>0.1.0-alpha.5</Version>
    <Authors>MiniMockito.Net contributors</Authors>
    <Description>EXPERIMENTAL, TEST-ONLY shim infrastructure for MiniMockito.Net. Build-time IL rewrite (Mono.Cecil) for newobj interception and user-defined static method mocking via an isolated AssemblyLoadContext, plus high-level facades: Shims.For&lt;T&gt;() (WithNew/WithStatic/New/Static) and the Easy API Shims.ForAssembly(path).ReplaceNew(...) including cross-assembly new interception (WithExternalTarget / RegisterShim by type, Type, or assembly path + type full name). NOT stable — public API may change in future phases. Does NOT rewrite production assemblies in place and does NOT support BCL static methods (e.g. DateTime.Now, File.ReadAllText), generic methods, or expression-based shim APIs. Parallel test execution is unsafe; tests must use [assembly: DoNotParallelize].</Description>
    <PackageTags>mocking;testing;mstest;shims;experimental</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/kaneko11/offgrid-gatch-mock</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kaneko11/offgrid-gatch-mock</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1574: cref references to types excluded via #if (e.g. ShimAssemblyLoadContext) on net48 -->
    <!-- CS8604: nullable reference warnings from EqualityComparer/HashSet on net48 (analysis-only) -->
    <NoWarn>$(NoWarn);CS1574;CS8604</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>MiniMockito.Shims.Experimental.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
