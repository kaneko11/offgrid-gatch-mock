<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MiniMockito.Shims.Experimental</AssemblyName>
    <RootNamespace>MiniMockito.Shims.Experimental</RootNamespace>
    <PackageId>MiniMockito.Shims.Experimental</PackageId>
    <Title>MiniMockito.Shims.Experimental</Title>
    <Version>0.1.0-alpha.3</Version>
    <Authors>MiniMockito.Net contributors</Authors>
    <Description>Experimental shim infrastructure for MiniMockito.Net (Phase 14.5 milestone). Provides build-time IL rewrite for newobj interception and user-defined static method mocking via an isolated AssemblyLoadContext. NOT stable — API may change in future phases. BCL static methods, generic methods, and expression-based shim APIs are not supported. Parallel test execution requires [assembly: DoNotParallelize].</Description>
    <PackageTags>mocking;testing;mstest;shims;experimental</PackageTags>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>MiniMockito.Shims.Experimental.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
